#!/bin/bash
# List running Claude Code sessions in tmux with fzf and jump to the selected pane.
#
# Usage:
#   tmux-claude-sessions          # interactive (intended for tmux display-popup)
#   tmux-claude-sessions --list   # print formatted session list only

set -u

SESSIONS_DIR="$HOME/.claude/sessions"

is_exists() { type "$1" >/dev/null 2>&1; }

# Emits "pid<TAB>pane_id<TAB>status<TAB>name<TAB>cwd<TAB>updatedAt(ms)" per session.
# ~/.claude/sessions/<pid>.json is an internal format of Claude Code, so keep all
# knowledge about it in this function. Only whitelisted fields are read.
read_session_files() {
    local files=("$SESSIONS_DIR"/*.json)
    [ -e "${files[0]}" ] || return 0

    jq -r '
        select((.tmux // "") != "")
        | [
            .pid,
            (.tmux | split(".") | last),
            (.status // "unknown"),
            (.name // "-"),
            (.cwd // "-"),
            (.updatedAt // 0)
          ]
        | @tsv
    ' "${files[@]}" 2>/dev/null
}

# Emits "pane_id<TAB>line" per session, preceded by a header line whose pane_id
# is empty. Column widths follow the content via column(1), which also handles
# wide characters.
list_sessions() {
    local panes rows
    panes=$(tmux list-panes -a -F '#{pane_id}	#{session_name}:#{window_index}.#{pane_index}')

    rows=$(read_session_files \
        | while IFS=$'\t' read -r pid pane status name cwd updated; do
            kill -0 "$pid" 2>/dev/null || continue
            printf '%s\t%s\t%s\t%s\t%s\n' "$pane" "$status" "$name" "$cwd" "$updated"
        done \
        | awk -F'\t' -v now="$(date +%s)" -v home="$HOME" '
            function ago(ms,    d) {
                d = now - int(ms / 1000)
                if (d < 0) d = 0
                if (d < 60) return d "s ago"
                if (d < 3600) return int(d / 60) "m ago"
                if (d < 86400) return int(d / 3600) "h ago"
                return int(d / 86400) "d ago"
            }
            NR == FNR { loc[$1] = $2; next }
            !($1 in loc) { next }
            {
                pane = $1; status = $2; name = $3; cwd = $4; updated = $5
                if (index(cwd, home) == 1) cwd = "~" substr(cwd, length(home) + 1)

                # Unknown statuses (e.g. waiting for permission) come first since
                # they likely need attention.
                if (status == "busy")      { label = "active"; rank = 1 }
                else if (status == "idle") { label = "idle";   rank = 2 }
                else                       { label = status;   rank = 0 }

                printf "%d\t%d\t%s\t%s\t%s\t%s\t%s\t%s\n", rank, updated, pane, label, name, ago(updated), loc[pane], cwd
            }
        ' <(printf '%s\n' "$panes") - \
        | sort -t $'\t' -k1,1n -k2,2nr \
        | cut -f3-)
    rows=$(printf '\tSTATUS\tNAME\tUPDATED\tTMUX\tPATH\n%s' "$rows")

    paste <(cut -f1 <<<"$rows") <(cut -f2- <<<"$rows" | column -t -s $'\t') \
        | awk -F'\t' '
            NR == 1 { print; next }
            {
                label = $2; sub(/ .*/, "", label)
                if (label == "active")    color = "\033[32m"
                else if (label == "idle") color = "\033[90m"
                else                      color = "\033[33m"
                sub(/^[^ ]+/, color "&\033[0m", $2)
                print $1 FS $2
            }
        '
}

main() {
    local cmd
    for cmd in tmux jq fzf column; do
        if ! is_exists "$cmd"; then
            echo "$cmd not found" 1>&2
            exit 1
        fi
    done

    if [ "${1:-}" = "--list" ]; then
        list_sessions
        exit 0
    fi

    local selected pane

    selected=$(
        list_sessions | fzf \
            --height=100% \
            --no-border \
            --ansi \
            --delimiter=$'\t' \
            --with-nth=2 \
            --no-sort \
            --reverse \
            --header-lines=1 \
            --header-first \
            --prompt='claude> ' \
            --bind="ctrl-r:reload($(printf '%q' "$0") --list)" \
            --preview='tmux capture-pane -ep -t {1}' \
            --preview-window='down,70%,follow'
    ) || exit 0

    pane=$(printf '%s' "$selected" | cut -f1)
    [ -n "$pane" ] || exit 0

    tmux switch-client -t "$pane" \; select-window -t "$pane" \; select-pane -t "$pane"
}

main "$@"
